# Copy this file to .env to change settings. Everything here is optional:
# without an API key the app runs fully free and offline (rule-based reader).

# Turn on the AI reader / letter polishing (Claude). Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# Model. Default: claude-opus-5-5. For lower cost use claude-haiku-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Where saved policies and complaint trackers are stored.
# CLAIMSAATHI_DB=claimsaathi.db
